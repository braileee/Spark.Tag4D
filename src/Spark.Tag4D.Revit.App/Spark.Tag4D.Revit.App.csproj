<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Revit.props" />

  <!-- Revit add-in features: Tag (pane), Review (pane), ProjectSettings (window) and shared Infrastructure. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>Spark.Tag4D.Revit.App</RootNamespace>
    <AssemblyName>Spark.Tag4D.Revit.App</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- The features live in their own folders/namespaces; they share these namespaces freely. -->
  <ItemGroup>
    <Using Include="Spark.Tag4D.Revit.App.Infrastructure" />
    <Using Include="Spark.Tag4D.Revit.App.ProjectSettings" />
    <Using Include="Spark.Tag4D.Revit.App.Review" />
    <Using Include="Spark.Tag4D.Revit.App.Tag" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spark.Tag4D.Core\Spark.Tag4D.Core.csproj" />
    <ProjectReference Include="..\Spark.Tag4D.UI\Spark.Tag4D.UI.csproj" />
    <ProjectReference Include="..\Spark.Tag4D.Settings\Spark.Tag4D.Settings.csproj" />
    <ProjectReference Include="..\Spark.Tag4D.Revit.Core\Spark.Tag4D.Revit.Core.csproj" />
  </ItemGroup>

</Project>
