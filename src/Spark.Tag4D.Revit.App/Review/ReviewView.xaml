<Page x:Class="Spark.Tag4D.Revit.App.Review.ReviewView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F6F8FB" Foreground="#0F172A"
      FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <!-- Background / Foreground / Font are set explicitly: a Page does not pick up an implicit style from its own resources. -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Spark.Tag4D.UI;component/Themes/Tag4D.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12,16,14">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionText}" Text="Review"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10" TextWrapping="Wrap"
                           Text="Check the parameters that must have a value. Elements where any of them is empty are isolated in a 3D view."/>

                <Grid>
                    <TextBox x:Name="SearchBox" Padding="30,5,8,5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search parameters by name"/>
                    <Path Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Stretch="None"
                          Data="M5,0.8 A4.2,4.2 0 1 0 5,9.2 A4.2,4.2 0 1 0 5,0.8 M8.2,8.2 L11.5,11.5"
                          Stroke="{StaticResource DisabledBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource DisabledBrush}" Text="Search parameters">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Check all" Command="{Binding CheckAllCommand}" Margin="0,0,8,0" ToolTip="Check all parameters shown"/>
                    <Button Content="Clear" Command="{Binding ClearAllCommand}" Margin="0,0,8,0" ToolTip="Uncheck all parameters shown"/>
                    <Button Content="Reload" Command="{Binding ReloadCommand}" ToolTip="Read the parameters from the workbook again"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,0">
            <ItemsControl ItemsSource="{Binding ProjectSettingsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="0,0,0,8" IsChecked="{Binding IsChecked}" Content="{Binding Name}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Padding="14,7" Content="Show elements with missing values"
                            Command="{Binding ShowCommand}"
                            ToolTip="Isolates the elements that have no value in at least one checked parameter, in the 3D view 'Tag 4D - Review'"/>
                    <Button Grid.Column="2" Content="Reset isolation" Command="{Binding ResetCommand}" ToolTip="Show all elements of the 3D view again"/>
                </Grid>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Status}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
