<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MicroStation add-in. MicroStation's assemblies are not published on NuGet, so they are referenced
    from an installation (or an extracted copy of one, which is what CI uses):
        dotnet build -p:MicroStationDir="C:\Program Files\Bentley\MicroStation 2025\MicroStation"
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Spark.Tag4D.Microstation</RootNamespace>
    <AssemblyName>Spark.Tag4D.Microstation</AssemblyName>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <MicroStationDir Condition="'$(MicroStationDir)' == ''">C:\Program Files\Bentley\MicroStation 2025\MicroStation</MicroStationDir>
    <ArtifactsPivots>$(Configuration.ToLowerInvariant())_ms2025</ArtifactsPivots>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spark.Tag4D.Core\Spark.Tag4D.Core.csproj" />
    <ProjectReference Include="..\Spark.Tag4D.UI\Spark.Tag4D.UI.csproj" />
    <ProjectReference Include="..\Spark.Tag4D.Settings\Spark.Tag4D.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="commands.xml" LogicalName="CommandTable.xml" />
  </ItemGroup>

  <!-- Bentley assemblies: compile-time only, MicroStation provides them at run time. -->
  <ItemGroup>
    <Reference Include="Bentley.DgnDisplayNET">
      <HintPath>$(MicroStationDir)\Bentley.DgnDisplayNet.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Bentley.DgnPlatformNET">
      <HintPath>$(MicroStationDir)\Bentley.DgnPlatformNET.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Bentley.Interop.MicroStationDGN">
      <HintPath>$(MicroStationDir)\Assemblies\Bentley.Interop.MicroStationDGN.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Bentley.Platform">
      <HintPath>$(MicroStationDir)\Assemblies\ECFramework\Bentley.Platform.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Bentley.ECObjects3">
      <HintPath>$(MicroStationDir)\Assemblies\ECFramework\Bentley.ECObjects3.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="ustation">
      <HintPath>$(MicroStationDir)\ustation.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Assemble the folder that the installer packages: the add-in, its dependencies and the default settings. -->
  <Target Name="StageMdlApp" AfterTargets="Build">
    <PropertyGroup>
      <StageDir>$(MSBuildProjectDirectory)\..\..\artifacts\package\Spark.Tag4D.Microstation</StageDir>
    </PropertyGroup>
    <ItemGroup>
      <StageFile Include="$(OutDir)**\*.*" Exclude="$(OutDir)**\*.pdb;$(OutDir)**\*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(StageFile)" DestinationFiles="@(StageFile->'$(StageDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
