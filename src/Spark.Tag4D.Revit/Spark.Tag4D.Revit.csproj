<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Revit.props" />

  <!--
    Revit add-in entry point (ribbon tab + dockable pane).
    Build one release at a time:   dotnet build -c Release -p:RevitVersion=2025
    Dev loop (copies the add-in to %APPDATA%\Autodesk\Revit\Addins\<year>):   -p:DeployToRevit=true
  -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>Spark.Tag4D.Revit</RootNamespace>
    <AssemblyName>Spark.Tag4D.Revit</AssemblyName>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spark.Tag4D.Revit.App\Spark.Tag4D.Revit.App.csproj" />
    <ProjectReference Include="..\Spark.Tag4D.Revit.Core\Spark.Tag4D.Revit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\*.png" />
    <Content Include="Resources\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Writes the .addin manifest that sits next to the assemblies (used by the installer's ApplicationPlugins bundle). -->
  <Target Name="WriteAddinManifest" AfterTargets="Build">
    <PropertyGroup>
      <AddinAssemblyPath Condition="'$(AddinAssemblyPath)' == ''">Spark.Tag4D.Revit.dll</AddinAssemblyPath>
      <AddinManifestText><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>Spark.Tag4D</Name>
    <Assembly>@@ASSEMBLY@@</Assembly>
    <AddInId>D917A2A3-EE19-4EB3-9CFC-3A96D838C9A3</AddInId>
    <FullClassName>Spark.Tag4D.Revit.Tag4DApplication</FullClassName>
    <VendorId>SPRK</VendorId>
    <VendorDescription>Spark</VendorDescription>
  </AddIn>
</RevitAddIns>]]></AddinManifestText>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)Spark.Tag4D.Revit.addin"
                      Lines="$(AddinManifestText.Replace('@@ASSEMBLY@@', 'Spark.Tag4D.Revit.dll'))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Developer convenience: copy the build to the current user's Revit add-ins folder. -->
  <Target Name="DeployToRevitAddins" AfterTargets="WriteAddinManifest" Condition="'$(DeployToRevit)' == 'true' And '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <RevitAddinsDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsDir>
      <DeployDir>$(RevitAddinsDir)\Spark.Tag4D</DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFile Include="$(OutDir)**\*.*" Exclude="$(OutDir)*.addin;$(OutDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFile)" DestinationFiles="@(DeployFile->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <WriteLinesToFile File="$(RevitAddinsDir)\Spark.Tag4D.addin"
                      Lines="$(AddinManifestText.Replace('@@ASSEMBLY@@', 'Spark.Tag4D\Spark.Tag4D.Revit.dll'))"
                      Overwrite="true" />
  </Target>

</Project>
