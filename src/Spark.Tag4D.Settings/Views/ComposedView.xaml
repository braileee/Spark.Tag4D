<UserControl x:Class="Spark.Tag4D.Settings.Views.ComposedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Spark.Tag4D.UI.Controls;assembly=Spark.Tag4D.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Spark.Tag4D.Settings.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Spark.Tag4D.UI;component/Themes/Tag4D.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- six dots: the "drag me" handle -->
            <GeometryGroup x:Key="GripGeometry">
                <EllipseGeometry Center="2,2" RadiusX="1.5" RadiusY="1.5"/>
                <EllipseGeometry Center="8,2" RadiusX="1.5" RadiusY="1.5"/>
                <EllipseGeometry Center="2,8" RadiusX="1.5" RadiusY="1.5"/>
                <EllipseGeometry Center="8,8" RadiusX="1.5" RadiusY="1.5"/>
                <EllipseGeometry Center="2,14" RadiusX="1.5" RadiusY="1.5"/>
                <EllipseGeometry Center="8,14" RadiusX="1.5" RadiusY="1.5"/>
            </GeometryGroup>

            <!-- A segment: [prefix] [property] [suffix] kept together in one card -->
            <DataTemplate x:Key="SegmentTemplate">
                <Grid Margin="0,0,10,0">
                    <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="8" AllowDrop="True"
                            PreviewDragOver="Segment_PreviewDragOver" PreviewDragLeave="Segment_PreviewDragLeave" PreviewDrop="Segment_PreviewDrop">
                        <StackPanel>

                            <!-- Card header: drag handle and the +/- of this segment -->
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7,7,0,0" Padding="6,4"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MinusButton}" Width="22" Height="22" Margin="4,0,0,0"
                                            ToolTip="Remove this segment"
                                            Command="{Binding DataContext.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PlusButton}" Width="22" Height="22"
                                            ToolTip="Insert a new segment after this one"
                                            Command="{Binding DataContext.InsertSegmentAfterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to reorder" HorizontalAlignment="Left"
                                            Padding="4,2" PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown" PreviewMouseMove="Grip_PreviewMouseMove">
                                        <Path Data="{StaticResource GripGeometry}" Fill="{StaticResource BorderStrongBrush}" Stretch="None"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="54"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Style="{StaticResource HintTextBox}" Tag="prefix" ToolTip="Text before the value"
                                         Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/>

                                <ComboBox Grid.Column="1" Margin="6,0"
                                          ItemsSource="{Binding DataContext.AvailableProperties, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="PropertyName" SelectedValuePath="PropertyName"
                                          SelectedValue="{Binding SelectedProperty, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBox Grid.Column="2" Style="{StaticResource HintTextBox}" Tag="suffix" ToolTip="Text after the value"
                                         Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- where a dragged item will land -->
                    <Border x:Name="LeftBar" Width="4" HorizontalAlignment="Left" Margin="-7,0,0,0" CornerRadius="2"
                            Background="{StaticResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Border x:Name="RightBar" Width="4" HorizontalAlignment="Right" Margin="0,0,-7,0" CornerRadius="2"
                            Background="{StaticResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Card" Property="local:ComposedView.DropSide" Value="Left">
                        <Setter TargetName="LeftBar" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger SourceName="Card" Property="local:ComposedView.DropSide" Value="Right">
                        <Setter TargetName="RightBar" Property="Visibility" Value="Visible"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource SheetChip}">
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding SheetInfo}"/>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="+  Add Property" Command="{Binding AddComposedPropertyCommand}"/>
                    <controls:SearchBox Margin="16,0,0,0" Text="{Binding FilterText}" Hint="{Binding FilterHint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Palette: drag a property onto a formula to add it as a segment -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,4,12,0"
                           Text="Properties" ToolTip="Drag a property onto a formula to add it as a segment"/>
                <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AvailableProperties}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="10,3" Margin="0,2,6,2" Cursor="Hand" ToolTip="Drag onto a formula"
                                        PreviewMouseLeftButtonDown="Chip_PreviewMouseLeftButtonDown" PreviewMouseMove="Chip_PreviewMouseMove">
                                    <TextBlock Text="{Binding PropertyName}" Foreground="{StaticResource TextBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ComposedPropertiesView}" Margin="16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>

                                <!-- Composed property -->
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Delete"
                                            Command="{Binding DataContext.DeleteComposedPropertyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource MutedText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="0,0,10,0" Text="Composed property"/>
                                    <ComboBox Width="300" HorizontalAlignment="Left"
                                              ItemsSource="{Binding DataContext.AvailableProperties, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="PropertyName" SelectedValuePath="PropertyName"
                                              SelectedValue="{Binding Name}"/>
                                </DockPanel>

                                <!-- Formula: segments left to right, "+ Segment" adds the next one on the right -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,2,0,12" AllowDrop="True"
                                                DragOver="Row_DragOver" Drop="Row_Drop">
                                        <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource SegmentTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <Button VerticalAlignment="Center" Style="{StaticResource ActionButton}" Content="+  Segment" Height="44"
                                                ToolTip="Add a segment at the end of the formula"
                                                Command="{Binding DataContext.AddSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Result -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MutedText}" FontWeight="SemiBold" Text="Formula  " VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource SheetChip}" CornerRadius="6" Padding="8,3">
                                        <TextBlock FontFamily="Consolas" Foreground="{StaticResource TextBrush}" Text="{Binding Preview}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
