<UserControl x:Class="Spark.Tag4D.Settings.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Spark.Tag4D.UI.Controls;assembly=Spark.Tag4D.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Spark.Tag4D.UI;component/Themes/Tag4D.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A cell is an editable pick list: a value can be picked from the picklist of its property or typed.
                 Values that are not in that picklist (a typo) are marked, because they can never be selected when tagging. -->
            <Style x:Key="MatchValueCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="IsEditable" Value="True"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                        <Setter Property="BorderBrush" Value="#D97706"/>
                        <Setter Property="ToolTip" Value="This value is not in the picklist of the property"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MatchTargetCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="IsEditable" Value="True"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTargetUnknown}" Value="True">
                        <Setter Property="BorderBrush" Value="#D97706"/>
                        <Setter Property="ToolTip" Value="This value is not in the picklist of the target property"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource SheetChip}">
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding SheetInfo}"/>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="+  Add Match Table" Command="{Binding AddMatchTableCommand}"/>
                    <controls:SearchBox Margin="16,0,0,0" Text="{Binding FilterText}" Hint="{Binding FilterHint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl ItemsSource="{Binding MatchTables}" x:Name="MatchTablesTabControl">

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding SheetPrefix}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DockPanel>

                        <!-- Table strip: add property / row, sheet name, delete table -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Background="Transparent">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Delete Table"
                                        Command="{Binding DataContext.RemoveMatchTableCommand, ElementName=MatchTablesTabControl}"
                                        CommandParameter="{Binding}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButton}" Content="+  Add Property" Command="{Binding AddSourcePropertyCommand}"
                                            ToolTip="Add a column: another property the target value depends on"/>
                                    <Button Style="{StaticResource ActionButton}" Content="+  Add Row" Margin="8,0,20,0" Command="{Binding AddRowCommand}"/>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedText}" FontWeight="SemiBold" Text="Sheet name" Margin="0,0,8,0"/>
                                    <TextBox Width="220" Text="{Binding SheetPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Border Style="{StaticResource SheetChip}" Margin="6,0,0,0" CornerRadius="6">
                                        <TextBlock Style="{StaticResource MutedText}" Text="Match"/>
                                    </Border>
                                    <Border Style="{StaticResource SheetChip}" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding RowCountText}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- One horizontal scroll area for header and rows; the rows scroll (and virtualize) vertically on their own. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <DockPanel Margin="16,16,16,0" HorizontalAlignment="Left" LastChildFill="True">

                                <!-- Header row: one combo per source property, then the target property -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">

                                    <ItemsControl ItemsSource="{Binding SourceProperties}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="180" Margin="0,0,8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding AvailableProperties}"
                                                              SelectedItem="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="1" Style="{StaticResource CrossButton}" Margin="2,0,0,0" ToolTip="Remove this column"
                                                            Command="{Binding DataContext.RemoveSourcePropertyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Target property -->
                                    <ComboBox Width="200" Margin="0,0,8,0" ItemsSource="{Binding AvailableProperties}"
                                              SelectedItem="{Binding TargetProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Border Width="28"/>
                                </StackPanel>

                                <!-- Data rows -->
                                <ItemsControl ItemsSource="{Binding RowsView}" VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="True" Padding="0,0,0,16">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                                <ItemsControl ItemsSource="{Binding Criteria}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ComboBox Style="{StaticResource MatchValueCombo}" Width="180" Margin="0,0,8,0"
                                                                      ItemsSource="{Binding Suggestions}"
                                                                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ComboBox Style="{StaticResource MatchTargetCombo}" Width="200" Margin="0,0,8,0"
                                                          ItemsSource="{Binding TargetSuggestions}"
                                                          Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}"/>

                                                <Button Style="{StaticResource CrossButton}" ToolTip="Delete this row"
                                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>
    </DockPanel>
</UserControl>
