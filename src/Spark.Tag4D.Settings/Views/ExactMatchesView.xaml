<UserControl x:Class="Spark.Tag4D.Settings.Views.ExactMatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Spark.Tag4D.UI;component/Themes/Tag4D.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource SheetChip}">
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding SheetInfo}"/>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="+  Add Table" Command="{Binding AddTableCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl ItemsSource="{Binding Tables}">

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding SheetPrefix}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DockPanel>

                        <!-- Table strip: sheet name, add row, delete table -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}" Background="Transparent">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Delete Table"
                                        Command="{Binding DataContext.RemoveTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButton}" Content="+  Add Row" Command="{Binding AddRowCommand}" Margin="0,0,20,0"/>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedText}" FontWeight="SemiBold" Text="Sheet name" Margin="0,0,8,0"/>
                                    <TextBox Width="220" Text="{Binding SheetPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Border Style="{StaticResource SheetChip}" Margin="6,0,0,0" CornerRadius="6">
                                        <TextBlock Style="{StaticResource MutedText}" Text="Exact Match"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel Margin="16" HorizontalAlignment="Left">

                                <!-- Column headers: which property each column belongs to -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox ItemsSource="{Binding AvailableColumnNames}"
                                              SelectedItem="{Binding SourceColumnHeader, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding AvailableColumnNames}"
                                              SelectedItem="{Binding TargetColumnHeader, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="2" Style="{StaticResource CrossButton}" HorizontalAlignment="Right" ToolTip="Delete this row"
                                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>
    </DockPanel>
</UserControl>
