<UserControl x:Class="Spark.Tag4D.UI.Controls.SearchableComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" Cursor="Hand">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Spark.Tag4D.UI;component/Themes/Tag4D.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SearchItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent" Padding="10,6" CornerRadius="4" Margin="2,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Chrome" MinHeight="32" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"/>
        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Template="{StaticResource ComboToggleButton}"
                      IsChecked="{Binding IsOpen, ElementName=Root, Mode=TwoWay}"/>
        <TextBlock x:Name="Display" Margin="8,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>

        <Popup x:Name="DropDown" Placement="Bottom" IsOpen="{Binding IsOpen, ElementName=Root, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Grid MinWidth="{Binding ActualWidth, ElementName=Root}" Margin="0,4,12,12">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
                    </Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,2,2,6">
                            <TextBox x:Name="SearchBox" Padding="28,5,8,5" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                            <Path Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Stretch="None"
                                  Data="M5,0.8 A4.2,4.2 0 1 0 5,9.2 A4.2,4.2 0 1 0 5,0.8 M8.2,8.2 L11.5,11.5"
                                  Stroke="{StaticResource DisabledBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource DisabledBrush}" Text="Search values">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="NoMatches" DockPanel.Dock="Bottom" Margin="10,4,10,6" Visibility="Collapsed"
                                   Foreground="{StaticResource DisabledBrush}" Text="No matching values"/>
                        <ListBox x:Name="List" MaxHeight="260" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource SearchItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
