<UserControl x:Class="Spark.Tag4D.UI.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="280" Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Spark.Tag4D.UI;component/Themes/Tag4D.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The search box of every page: magnifier, hint while empty, clear button while filled. -->
    <Grid>
        <TextBox x:Name="Box" Padding="30,5,28,5" Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding ToolTip, ElementName=Root}"/>
        <Path Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
              Stretch="None" Data="M5,0.8 A4.2,4.2 0 1 0 5,9.2 A4.2,4.2 0 1 0 5,0.8 M8.2,8.2 L11.5,11.5"
              Stroke="{StaticResource DisabledBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <TextBlock Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.7"
                   Foreground="{StaticResource DisabledBrush}" Text="{Binding Hint, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=Box}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button HorizontalAlignment="Right" Margin="0,0,3,0" Style="{StaticResource CrossButton}" ToolTip="Clear the search"
                Click="Clear_Click">
            <Button.Visibility>
                <Binding Path="Text" ElementName="Box">
                    <Binding.Converter>
                        <local:TextToVisibilityConverter xmlns:local="clr-namespace:Spark.Tag4D.UI.Controls"/>
                    </Binding.Converter>
                </Binding>
            </Button.Visibility>
        </Button>
    </Grid>
</UserControl>
