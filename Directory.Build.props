<Project>

  <!-- Shared metadata and compiler settings for every project in the solution. -->
  <PropertyGroup>
    <Product>Spark.Tag4D</Product>
    <Company>Spark</Company>
    <Authors>Spark</Authors>
    <Copyright>Copyright © Spark</Copyright>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>

  <!-- Build output lives in <repo>/artifacts, keeping source folders clean. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
