<Project>

  <!-- Central package management: every package version in the solution is declared here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime: first-party Microsoft packages only (needed on .NET Framework / netstandard). -->
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />

    <!-- Revit API (compile-time). The concrete version is chosen per Revit release in build/Revit.props. -->
    <PackageVersion Include="Revit_All_Main_Versions_API_x64" Version="2025.0.0" />

    <!-- IFC validation (the only third-party runtime dependency). -->
    <PackageVersion Include="Xbim.Essentials" Version="6.0.565" />

    <!-- Installer authoring (build-time tool, never shipped). -->
    <PackageVersion Include="WixSharp.Core" Version="2.1.3" />

    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
