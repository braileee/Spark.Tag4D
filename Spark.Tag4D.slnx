<Solution>
  <!--
    Solution configurations are "<Debug|Release> <target>". The target selects what is built and, for Revit and MicroStation,
    which release the add-in is compiled and deployed for:
      R2023..R2026    Revit add-in for that release (+ shared libraries)
      MSCE, MS2025, MS2026   MicroStation CE / 2025 / 2026 add-in (+ shared libraries)
      IfcValidator    the standalone IFC validator (+ shared libraries)
      Installer       the installer builder only
    Plain Debug / Release build everything (Revit 2025, MicroStation 2025).
  -->
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Debug R2023" />
    <BuildType Name="Debug R2024" />
    <BuildType Name="Debug R2025" />
    <BuildType Name="Debug R2026" />
    <BuildType Name="Debug MSCE" />
    <BuildType Name="Debug MS2025" />
    <BuildType Name="Debug MS2026" />
    <BuildType Name="Debug IfcValidator" />
    <BuildType Name="Debug Installer" />
    <BuildType Name="Release" />
    <BuildType Name="Release R2023" />
    <BuildType Name="Release R2024" />
    <BuildType Name="Release R2025" />
    <BuildType Name="Release R2026" />
    <BuildType Name="Release MSCE" />
    <BuildType Name="Release MS2025" />
    <BuildType Name="Release MS2026" />
    <BuildType Name="Release IfcValidator" />
    <BuildType Name="Release Installer" />
    <Platform Name="Any CPU" />
  </Configurations>
